    // --- Módulos da Direita ---

    "cpu": {
        "interval": 2,
        //{usage}% 
        "format": "CPU @ {avg_frequency}GHz",
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "Mem {used:0.1f}GiB/{total:0.1f}GiB",
        "tooltip-format": "Uso: {percentage}%"
    },

    "network": {
        "interval": 5,
        "format-wifi": "Net: {essid}",
        "format-ethernet": "Net: Cabeada",
        "format-disconnected": "Net: Desconectado",
        "tooltip-format": "Sinal: {signaldBm}dBm ({signalStrength}%)",
        "on-click": "nm-connection-editor"
    },
 
    "sway/language": {
        "format": "{}",
        "format-short": "{}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "pulseaudio": {
        "format": "Vol: {volume}% ",
        "format-muted": "Vol: Mudo ",
        "on-click": "pavucontrol",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle",
        "on-scroll-up": "pactl set-sink-volume @DEFAULT_SINK@ +2%",
        "on-scroll-down": "pactl set-sink-volume @DEFAULT_SINK@ -2%"
    },

    // Separador personalizado "|"
    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "tray": {
        "spacing": 5
    },

    //for spotify and other music players
    "mpris": {
    "format": "{player_icon} {title} - {artist}",
    "format-paused": "{status_icon} <i>{title} - {artist}</i>",
    "player-icons": { "default": "▶", "spotify": "" },
    "status-icons": { "paused": "⏸" },
    "ignored-players": ["firefox", "zen-alpha", "chromium"],
    "max-length": 40,
    "on-click": "swaync-client -t -sw"
    },
    
    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    }
}
