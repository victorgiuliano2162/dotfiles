{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    // Módulos da Esquerda
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "mpris"
    ],

    // Módulos do Centro (Temperatura do ambiente + Relógio)
    "modules-center": [
        "custom/weather",
        "custom/separator_center",
        "clock"
    ],

    // Módulos da Direita (com Teclado entre Net e Vol)
    "modules-right": [
        "cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "network",
        "tray",
        "custom/separator",
        "sway/language",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "custom/notification"
    ],

    // --- Módulos do Centro ---

    "custom/weather": {
    "format": "Temp: {}",
    "interval": 1800,
    "exec": "curl -s --max-time 3 'https://wttr.in/?format=%t' | sed 's/^+//' || echo 'N/D'",
    "tooltip": true
    },

    "custom/separator_center": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "clock": {
        "format": " {:%H:%M - %d/%m/%Y}",
        "tooltip-format": "{:%A, %d de %B de %Y}",
        "on-click": "gsimplecal"
    },

