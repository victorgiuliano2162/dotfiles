{
    "layer": "top",
    "position": "top",
    "height": 30,
    "spacing": 0,

    // Módulos da Esquerda
    "modules-left": [
        "sway/workspaces",
        "sway/mode",
        "mpris"
    ],

    // Módulos do Centro (Temperatura do ambiente + Relógio)
    "modules-center": [
        "custom/weather",
        "custom/separator_center",
        "clock"
    ],

    // Módulos da Direita (com Teclado entre Net e Vol)
    "modules-right": [
        "cpu",
        "custom/separator",
        "memory",
        "custom/separator",
        "network",
        "tray",
        "custom/separator",
        "sway/language",
        "custom/separator",
        "pulseaudio",
        "custom/separator",
        "custom/notification",
        "custom/separator",
        "custom/power"
    ],

    // --- Módulos do Centro ---

    "custom/weather": {
        "format": "Temp: {}",
        "interval": 120,
        "return-type": "json",
        "exec": "$HOME/.config/waybar/weather.py",
        "tooltip": true
    },

    "custom/separator_center": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "clock": {
        "format": " {:%H:%M - %d/%m/%Y}",
        "tooltip-format": "<tt><big>{calendar}</big></tt>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months": "<span color='#89b4fa'><b>{}</b></span>",
                "days": "<span color='#cdd6f4'><b>{}</b></span>",
                "weeks": "<span color='#a6adc8'><b>S{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today": "<span color='#f38ba8'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        }
    },

    // --- Módulos da Direita ---

    "cpu": {
        "interval": 2,
        "format": "CPU @ {avg_frequency}GHz",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip": true
    },

    "memory": {
        "interval": 2,
        "format": "Mem {used:0.1f}GiB/{total:0.1f}GiB",
        "states": {
            "warning": 70,
            "critical": 90
        },
        "tooltip-format": "Uso: {percentage}%"
    },

    "network": {
        "interval": 5,
        "format-wifi": "Net: {essid}",
        "format-ethernet": "Net: Cabeada",
        "format-disconnected": "Net: Desconectado",
        "tooltip-format-wifi": "Sinal: {signaldBm}dBm ({signalStrength}%)",
        "tooltip-format-ethernet": "Interface: {ifname} ({ipaddr})",
        "tooltip-format-disconnected": "Sem conexão"
    },

    "sway/language": {
        "format": "{}",
        "format-short": "{}",
        "on-click": "swaymsg input type:keyboard xkb_switch_layout next"
    },

    "pulseaudio": {
        "format": "Vol: {volume}%",
        "format-muted": "Vol: Mudo",
        "scroll-step": 2,
        "on-click": "$HOME/.config/waybar/audio-menu.py",
        "on-click-right": "pactl set-sink-mute @DEFAULT_SINK@ toggle"
    },

    // Separador personalizado "|"
    "custom/separator": {
        "format": "|",
        "interval": "once",
        "tooltip": false
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "all-outputs": true,
        "format": "{name}"
    },

    "tray": {
        "spacing": 5
    },

    // Reprodutores de mídia (Spotify e outros)
    "mpris": {
        "format": "{player_icon} {title} - {artist}",
        "format-paused": "{status_icon} <i>{title} - {artist}</i>",
        "player-icons": { "default": "▶", "spotify": "" },
        "status-icons": { "paused": "⏸" },
        "ignored-players": ["firefox", "zen-alpha", "chromium"],
        "max-length": 40
    },

    "custom/notification": {
        "tooltip": false,
        "format": "{icon}",
        "format-icons": {
            "notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "none": "",
            "dnd-notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "dnd-none": "",
            "inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "inhibited-none": "",
            "dnd-inhibited-notification": "<span foreground='#f38ba8'><sup></sup></span>",
            "dnd-inhibited-none": ""
        },
        "return-type": "json",
        "exec-if": "which swaync-client",
        "exec": "swaync-client -swb",
        "on-click": "swaync-client -t -sw",
        "on-click-right": "swaync-client -d -sw",
        "escape": true
    },

    "custom/power": {
        "format": "",
        "tooltip": true,
        "tooltip-format": "Opções de energia",
        "menu": "on-click",
        "menu-file": "$HOME/.config/waybar/power_menu.xml",
        "menu-actions": {
            "shutdown": "systemctl poweroff",
            "suspend": "systemctl suspend",
            "reboot": "systemctl reboot"
        }
    }
}
